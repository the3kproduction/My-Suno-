modules = ["nodejs-20", "python-3.11", "python3"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "discord-bot-test"

[[workflows.workflow]]
name = "Discord Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install discord.js axios dotenv && node index.js"

[[workflows.workflow]]
name = "discord-bot-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install discord.js axios dotenv && echo \"Dependencies installed successfully\""

[deployment]
run = ["sh", "-c", "npm install discord.js axios dotenv && node index.js"]
