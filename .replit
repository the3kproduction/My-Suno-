modules = ["nodejs-20", "python-3.11", "python3", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["ffmpeg", "yt-dlp"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "discord-bot-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Manual Trigger Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ultimate Suno Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AI Suno Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Enhanced AI Suno Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Enhanced Music Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Final Music Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Music Video Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Working 3AM Bot"

[[workflows.workflow]]
name = "discord-bot-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install discord.js axios dotenv && echo \"Dependencies installed successfully\""

[[workflows.workflow]]
name = "Manual Trigger Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node manual_trigger.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Ultimate Suno Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node ultimate_suno_bot.js"
waitForPort = 5000

[[workflows.workflow]]
name = "AI Suno Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node ai_suno_bot.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Enhanced AI Suno Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node final_render_bot.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Enhanced Music Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node final_render_bot.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Final Music Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node final_render_bot.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Music Video Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node final_render_bot.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Working 3AM Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node working_3am_bot.js"
waitForPort = 5000

[deployment]
run = ["sh", "-c", "npm install discord.js axios dotenv && node index.js"]

[[ports]]
localPort = 5000
externalPort = 80
